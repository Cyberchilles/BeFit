@model BeFit.Models.ExerciseType
@{
    ViewData["Title"] = "Usuń typ ćwiczenia";
}
<p>Czy na pewno chcesz usunąć ten typ ćwiczenia?</p>
<dl class="row"><dt>@Html.DisplayNameFor(m => m.Name)</dt><dd>@Model.Name</dd></dl>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button class="btn btn-danger" type="submit">Usuń</button>
    <a asp-action="Index">Anuluj</a>
</form>
