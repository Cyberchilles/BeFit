@model IEnumerable<BeFit.Models.TrainingSession>
@{
    ViewData["Title"] = "Moje treningi";
}
<p><a class="btn btn-primary" asp-action="Create">Dodaj trening</a></p>
@if (!Model.Any())
{
    <p>Nie masz jeszcze żadnych sesji treningowych.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead><tr>
            <th>@Html.DisplayNameFor(m => m.StartedAt)</th>
            <th>@Html.DisplayNameFor(m => m.EndedAt)</th><th>Operacje</th>
        </tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.StartedAt.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@item.EndedAt.ToString("dd.MM.yyyy HH:mm")</td>
                <td><a asp-action="Details" asp-route-id="@item.Id">Szczegóły</a>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edytuj</a>
                    <a asp-action="Delete" asp-route-id="@item.Id">Usuń</a>
                    <a asp-controller="WorkoutExercises" asp-action="Create" asp-route-sessionId="@item.Id">Dodaj ćwiczenie</a></td>
            </tr>
        }
        </tbody>
    </table>
}
