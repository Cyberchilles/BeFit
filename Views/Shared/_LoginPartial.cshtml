@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <span class="small text-muted me-2">@User.Identity?.Name</span>
    <form asp-area="Identity" asp-page="/Account/Logout"
          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
        <button type="submit" class="btn btn-outline-secondary btn-sm">Wyloguj</button>
    </form>
}
else
{
    <a class="btn btn-outline-primary btn-sm me-2" asp-area="Identity" asp-page="/Account/Login">Zaloguj</a>
    <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">Rejestracja</a>
}
